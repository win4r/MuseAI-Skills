// Runtime-cell manifest — packages and files for the persistent rootfs.
// Applied at image build time to rootfs-base, and at boot inside nspawn
// to reconcile the persistent rootfs against the new image.

// --- Apt repos ---
apt-repo "cloudflared" {
  signing-key-url "https://pkg.cloudflare.com/cloudflare-main.gpg"
  uris "https://pkg.cloudflare.com/cloudflared"
  suites "any"
  components "main"
  architectures "amd64"
}

// Node.js from NodeSource (nodejs 24 LTS) instead of the Ubuntu Noble universe
// deb (18.x, EOL upstream, no guaranteed security updates).
//
// nodejs is installed at BUILD from the vendored NodeSource .deb served by the
// local package repo (mkosi.images/cell/mkosi.packages, LFS; pinned in the cell
// mkosi.conf Packages= as nodejs=24.20.0-1nodesource1) -- exactly like the
// ffmpeg/libheif backports, so the build needs NO egress to deb.nodesource.com.
// The earlier design fetched the signing key + deb from NodeSource during the
// build-time reconcile; that fails closed in CI, whose build sandbox has no
// egress to deb.nodesource.com (HTTP 403 on the key). See T287440217.
//
// The NodeSource apt source is still configured for BOOT-time security updates:
// the .sources file below + a committed, dearmored keyring shipped via the cell
// skeleton (mkosi.skeleton/etc/apt/keyrings/nodesource.gpg). No build-time curl,
// so no network key rotation -- refresh the committed keyring if NodeSource
// rolls their signing key. Boot egress to deb.nodesource.com is allowlisted in
// hatch-sentinel managed-internal-network-policies.yaml.
file "/etc/apt/sources.list.d/nodesource.sources" {
  owner "root:root"
  mode "0644"
  content "Types: deb\nURIs: https://deb.nodesource.com/node_24.x\nSuites: nodistro\nComponents: main\nArchitectures: amd64\nSigned-By: /etc/apt/keyrings/nodesource.gpg\n"
}

// --- Packages ---
package "build-essential"
package "ca-certificates"
package "ccze"
package "cloudflared"
package "cmake"
