// Hard NEEDED entry of the vendored Shop Wallet CLI (Node.js single-executable
// builds link libatomic). Declared explicitly rather than relying on it
// arriving transitively via build-essential: the CLI is the only consumer, and
// a transitive dependency that goes away silently breaks the wallet binary at
// exec time with a loader error, not at build time.
package "libatomic1"
package "libcairo2-dev"
package "libgbm1"
package "libgtk-3-0"
package "libheif-examples"
package "libheif-plugin-ffmpegdec"
package "libheif-plugin-dav1d"
package "libnss3"
package "libnss3-tools"
package "libpango1.0-dev"
package "libssl-dev"
package "libudev-dev"
package "libwayland-dev"
package "libx11-dev"
package "libxkbcommon-dev"
package "lsof"
package "net-tools"
package "nodejs"
package "libreoffice-core-nogui"
package "libreoffice-writer-nogui"
package "libreoffice-calc-nogui"
package "libreoffice-impress-nogui"
package "openssh-client"
package "pkg-config"
package "poppler-utils"
package "procps"
package "psmisc"
package "python3"
package "python3-dev"
package "python3-docx"
package "python3-matplotlib"
package "python3-openpyxl"
package "python3-pip"
package "python3-plotly"
package "python3-seaborn"
package "python3-venv"
