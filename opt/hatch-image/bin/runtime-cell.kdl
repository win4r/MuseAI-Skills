// --- Files ---
file "/etc/systemd/system/default.target" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=Hatch runtime-cell minimal boot target\nDefaultDependencies=no\nWants=hatch-execd.socket\nAllowIsolate=yes\n"
}

file "/etc/systemd/system/hatch-execd.socket" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=hatch-execd socket\nDefaultDependencies=no\n\n[Socket]\nExecStartPre=+/usr/bin/install -d -m 0755 -o root -g root /run/hatch\nExecStartPre=+/usr/bin/install -d -m 0755 -o root -g root /run/hatch/execd\nListenStream=/run/hatch/execd/execd.sock\nSocketMode=0600\nRemoveOnStop=true\nService=hatch-execd.service\n\n[Install]\nWantedBy=sockets.target\n"
}

file "/etc/systemd/system/hatch-execd.service" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=hatch-execd\nDefaultDependencies=no\nStartLimitIntervalSec=0\nAfter=hatch-execd.socket\nRequires=hatch-execd.socket\n\n[Service]\nType=simple\nUMask=0007\nExecStartPre=/bin/sh -c 'test -f /opt/hatch/runtime-cell/runtime-cell.ready'\nExecStart=/opt/hatch/runtime-cell/run-execd.sh --socket /run/hatch/execd/execd.sock\nWorkingDirectory=/home/hatch\nRestart=always\nRestartSec=1\nLimitNOFILE=65535\nSyslogIdentifier=hatch-execd\n"
}

// Pin nodejs to NodeSource so it wins deterministically over any Ubuntu
// nodejs that a future dependency might pull in (NodeSource 24.x already
// out-versions Noble's 18.x, but the pin makes it explicit and downgrade-
// proof). This is a phase-30 file so it lands after the phase-20 install on
// a cold apply; that is fine because NodeSource wins by version anyway, and
// the pin governs every subsequent reconcile.
file "/etc/apt/preferences.d/nodesource" {
  owner "root:root"
  mode "0644"
  content "Package: nodejs\nPin: origin deb.nodesource.com\nPin-Priority: 700\n"
}

// Hold ffmpeg + its libav*/libsw* at the Noble-rebuilt 8.1.2 backport (the
// .debs ship in mkosi.images/cell/mkosi.packages and are baked in at image
// build). The backport repo is build-time only, so without this the reconcile's
// apt-get install could pull Noble's EOL 6.1.1 back in. Clears the exploited
// CVE-2026-8461 + top RCE-class CVEs (risk 100->19). See T287440217. The
// versionless `package "nodejs"`-style `package "ffmpeg"` above NoOps at boot
// because 8.1.2 is already installed.
file "/etc/apt/preferences.d/ffmpeg-backport" {
  owner "root:root"
  mode "0644"
  content "Package: ffmpeg libavcodec62 libavformat62 libavutil60 libavfilter11 libavdevice62 libswscale9 libswresample6\nPin: version 7:8.1.2*\nPin-Priority: 1001\n"
}

// Hold libheif at the Noble-rebuilt 1.23.3 backport (debs in
// mkosi.images/cell/mkosi.packages). Clears all 16 libheif CVEs; the ffmpegdec
// plugin is rebuilt against our libavcodec62 so the feed-HEIC decode path drops
// Noble's vulnerable libavcodec60 (the ffmpeg-backport soname residual). See
// T287440217. Same build-time-only-repo downgrade guard as ffmpeg above.
// libheif-plugin-dav1d is pinned too: libheif1 1.23 hard-Depends an AV1 decoder
// plugin (aomdec | dav1d) at the same version, so it must be held in lockstep.
file "/etc/apt/preferences.d/libheif-backport" {
  owner "root:root"
  mode "0644"
  content "Package: libheif1 libheif-examples libheif-plugin-ffmpegdec libheif-plugin-dav1d\nPin: version 1.23.3-1\nPin-Priority: 1001\n"
}

// Hold GraphicsMagick at the Noble-rebuilt 1.3.46 backport (debs in
// mkosi.images/cell/mkosi.packages). Built --with-heif against our libheif
// 1.23.3, so `gm` decodes HEIC/AVIF through libheif + the ffmpegdec/dav1d
// plugins; also clears the low-severity gm CVEs in Noble's 1.3.42. The coder lib
// libgraphicsmagick-q16-3t64 is pinned in lockstep. Requires the libheif backport
// above (libgraphicsmagick-q16-3t64 Depends libheif1 >= 1.20). See T287440217.
file "/etc/apt/preferences.d/graphicsmagick-backport" {
  owner "root:root"
  mode "0644"
  content "Package: graphicsmagick libgraphicsmagick-q16-3t64\nPin: version 1.4+really1.3.46-2\nPin-Priority: 1001\n"
}

// --- Retired OS-owned periodic/apt side services ---
// The cell's package state is owned by the Hatch manifest reconcile (this
// manifest, applied in the system-maintenance cgroup leaf under managed
// egress policy). The distro's own apt side machinery is retired in the
// cell: its units run OUTSIDE that leaf (apt hooks systemd-start them), so
// their egress reaches Sentinel unattributed — the apt/ESM/motd-news slice
// of the anonymous runtime.unknown ledger rows, and fleet-wide HITL prompt
// storms whenever they dial a host the managed system-egress allowlist does
// not carry (the 2026-08-15 cli.github.com storm). Each unit is shadowed by
// an inert /etc unit (the same override mechanism as default.target above,
// so the boot-time reconcile also retires them on existing cells): no
// [Service]/[Timer] section means nothing can run, and RefuseManualStart
// makes an apt-hook `systemctl start` fail cleanly instead of executing.
// Deliberate tradeoff (owner decision, 2026-08-22): no in-cell
// unattended-upgrades between image rolls; package freshness rides the
// reconcile plus VM replacement.
file "/etc/systemd/system/apt-daily.timer" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=Retired by Hatch: cell packages are reconcile-owned\nRefuseManualStart=yes\nRefuseManualStop=yes\n"
}

file "/etc/systemd/system/apt-daily-upgrade.timer" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=Retired by Hatch: cell packages are reconcile-owned\nRefuseManualStart=yes\nRefuseManualStop=yes\n"
}

file "/etc/systemd/system/unattended-upgrades.service" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=Retired by Hatch: cell packages are reconcile-owned\nRefuseManualStart=yes\nRefuseManualStop=yes\n"
}

file "/etc/systemd/system/apt-news.service" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=Retired by Hatch: cell apt news fetch is retired\nRefuseManualStart=yes\nRefuseManualStop=yes\n"
}

file "/etc/systemd/system/esm-cache.service" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=Retired by Hatch: cell ESM cache refresh is retired\nRefuseManualStart=yes\nRefuseManualStop=yes\n"
}

file "/etc/systemd/system/ua-timer.timer" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=Retired by Hatch: cell ubuntu-advantage jobs are retired\nRefuseManualStart=yes\nRefuseManualStop=yes\n"
}

file "/etc/systemd/system/motd-news.timer" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=Retired by Hatch: cell motd news fetch is retired\nRefuseManualStart=yes\nRefuseManualStop=yes\n"
}

file "/etc/systemd/system/update-notifier-download.timer" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=Retired by Hatch: cell packages are reconcile-owned\nRefuseManualStart=yes\nRefuseManualStop=yes\n"
}

file "/etc/systemd/system/update-notifier-motd.timer" {
  owner "root:root"
  mode "0644"
  content "[Unit]\nDescription=Retired by Hatch: cell packages are reconcile-owned\nRefuseManualStart=yes\nRefuseManualStop=yes\n"
}
