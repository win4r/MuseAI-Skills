# Managed by spawnd. Static runtime-cell /etc/hosts, rendered from install-time
# constants and bind-mounted read-only into the cell (and privsep workers).
# This file is authoritative and complete: it is NOT merged with any inherited
# rootfs entry. All values are static render constants, so the content is stable
# across boots and identical on every VM of a given image.
127.0.0.1 localhost
::1 localhost ip6-localhost ip6-loopback
# Map the cell's own hostname to loopback in both families so sudo/systemctl
# hostname canonicalization resolves via NSS files instead of stalling ~30s on a
# DNS query to the egress gateway, which cannot resolve the internal machine name.
127.0.1.1 htch-runtime
::1 htch-runtime
# Egress proxy aliases. The cell (and GWS privsep workers that inherit the cell
# proxy env) resolve hatch-egress-proxy to the veth gateway address.
198.19.0.1 hatch-egress-proxy
fd8b:4f84:7d32:99::1 hatch-egress-proxy
