# Managed by spawnd. Rendered KEY=VALUE cell runtime environment.
#
# This is a plain KEY=VALUE file (NOT a shell script): no logic, no command
# substitution, nothing the runtime cell can influence. It is installed
# root-owned under the runtime-cell dir (BindReadOnly into the cell), so the
# cell cannot edit it. The privsep trusted side reads it host-side to build the
# environment for partially/fully isolated tool invocations without sourcing a
# shell from a capability-bearing context.
#
# Keep the proxy/CA/HOME/PATH keys in parity with the exports in
# guest-runtime-env.sh (which serves the in-cell daemon path and may add
# daemon-specific vars). These values are derived purely from install-time
# template vars and intentionally do NOT depend on /etc/hatch/env.
HOME=/home/hatch
TMPDIR=/var/tmp
TMP=/var/tmp
TEMP=/var/tmp
XDG_CONFIG_HOME=/home/hatch/.config
XDG_CACHE_HOME=/home/hatch/.cache
XDG_STATE_HOME=/home/hatch/.local/state
JARVIS_HOME=/home/hatch
JARVIS_BIN_DIR=/opt/hatch/bin
JARVIS_AUTHD_SOCK=/run/hatch/auth/authd.sock
JARVIS_STEFI_PROXY_SOCK=/run/hatch/proxy/stefi.sock
HTTP_PROXY=http://hatch-egress-proxy:3128
HTTPS_PROXY=http://hatch-egress-proxy:3128
ALL_PROXY=http://hatch-egress-proxy:3128
http_proxy=http://hatch-egress-proxy:3128
https_proxy=http://hatch-egress-proxy:3128
all_proxy=http://hatch-egress-proxy:3128
NO_PROXY=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2,fd8b:4f84:7d32:99::1,[fd8b:4f84:7d32:99::1],fd8b:4f84:7d32:99::2,[fd8b:4f84:7d32:99::2]
no_proxy=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2,fd8b:4f84:7d32:99::1,[fd8b:4f84:7d32:99::1],fd8b:4f84:7d32:99::2,[fd8b:4f84:7d32:99::2]
SSL_CERT_FILE=/run/hatch/egress-tls/ca-bundle.pem
REQUESTS_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem
CURL_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem
WGETRC=/opt/hatch/runtime-cell/etc/wgetrc
AWS_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem
NODE_EXTRA_CA_CERTS=/run/hatch/egress-tls/ca-bundle.pem
# Node's built-in fetch (undici) ignores HTTP(S)_PROXY unless this opt-in flag
# is set (Node 24, backported to recent 22.x; verified honored on 22.22.3);
# without it a Node-based CLI dials its target directly and dies on the cell's
# deliberately dead DNS.
NODE_USE_ENV_PROXY=1
GIT_SSL_CAINFO=/run/hatch/egress-tls/ca-bundle.pem
PATH=/opt/hatch/bin:/opt/hatch-image/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
